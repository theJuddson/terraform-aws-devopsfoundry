#!/usr/bin/env bash
# rotate-secret — rotate an app's Redis auth token or SES SMTP password without a
#                 failed request (#22).
#
# Usage: bin/rotate-secret --config <dir> redis|smtp [--yes]
#
# Each rotation has three steps, and the old credential works until the last:
#   1. Publish: make a new credential while the old one stays valid, and write
#      the new one to the app's secret (one terraform apply).
#   2. Roll:    force a new ECS deployment and wait until it is stable, so every
#      task has read the new credential.
#   3. Retire:  make the old credential stop working (one terraform apply).
#
# Redis: a new token generation applied with ROTATE (both tokens valid), then SET.
# SMTP:  two IAM key slots; the new key goes in the other slot, and the previous
#        key is made Inactive, not deleted, until the next rotation replaces it.
#
# app.tfvars records how far a rotation got (cache_auth_token_* and smtp_*_key),
# so re-running after a failure carries on from there. Each apply is planned
# first and refused if the plan changes anything else.
set -euo pipefail
DF_SCRIPT_NAME="rotate-secret"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

usage() { die "usage: bin/rotate-secret --config <dir> redis|smtp [--yes]"; }

CONFIG=""; WHICH=""; YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)    [[ $# -ge 2 ]] || usage; CONFIG="$2"; shift 2 ;;
    --yes|-y)    YES=true; shift ;;
    redis|smtp)  [[ -z "$WHICH" ]] || usage; WHICH="$1"; shift ;;
    *)           usage ;;
  esac
done
[[ -n "$WHICH" ]] || usage
CONFIG="$(df_resolve_config "$CONFIG")"
TFV="$CONFIG/app.tfvars"
[[ -f "$TFV" ]] || die "Missing $TFV"

case "$WHICH" in
  redis) [[ "$(df_tfvar "$TFV" enable_cache)" == true ]] || die "enable_cache is not true in $TFV: this app has no Redis token to rotate" ;;
  smtp)  [[ "$(df_tfvar "$TFV" enable_email)" == true ]] || die "enable_email is not true in $TFV: this app has no SMTP password to rotate" ;;
esac

# App roots scaffolded before v1.9.0 don't pass the rotation inputs to the module.
for v in cache_auth_token_generation cache_auth_token_update_strategy smtp_active_key smtp_standby_key; do
  grep -qE "^[[:space:]]*$v[[:space:]]*=" "$CONFIG/main.tf" && grep -q "variable \"$v\"" "$CONFIG/variables.tf" \
    || die "$CONFIG predates secret rotation: copy the 'Secret rotation' variables from templates/full-stack/variables.tf into its variables.tf, pass them in main.tf as in templates/full-stack/main.tf.tmpl, and use the module at v1.9.0 or later"
done

REGION="$(df_tfvar "$TFV" aws_region)"
REGION="${REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}}"
df_ensure_app_init "$CONFIG"
CLUSTER=$(df_tf_at "$CONFIG" output -raw ecs_cluster_name 2>/dev/null) || die "No ecs_cluster_name output: run new-app first"
SERVICE=$(df_tf_at "$CONFIG" output -raw ecs_service_name 2>/dev/null) || die "No ecs_service_name output: run new-app first"

WORK="$(mktemp -d)"   # plans hold secret values; keep them out of the app root
trap 'rm -rf "$WORK"' EXIT

# apply_step <what> <regex of the addresses it may change> <terraform args...>
apply_step() {
  local what="$1" allowed="$2"; shift 2
  local plan="$WORK/rotate.tfplan" others
  df_tf_at "$CONFIG" plan -input=false -out="$plan" -var-file=app.tfvars "$@" >/dev/null \
    || die "terraform plan failed for: $what"
  others="$(df_tf_at "$CONFIG" show -json "$plan" | jq -r --arg ok "$allowed" '
    .resource_changes[]? | select(.change.actions != ["no-op"] and .change.actions != ["read"])
    | .address | select(test($ok) | not)')"
  if [[ -n "$others" ]]; then
    echo "$others" | sed 's/^/    /'
    die "The plan to $what also changes the resources above. Apply those first (terraform apply, or bin/deploy-app), then re-run."
  fi
  df_plan_summary "$CONFIG" "$plan"
  if [[ "$YES" != true ]]; then
    read -r -p "Apply this to $what? (y/N) " c; [[ "$c" == [yY] ]] || { echo "Aborted."; exit 0; }
  fi
  df_tf_at "$CONFIG" apply -input=false "$plan" >/dev/null || die "terraform apply failed for: $what"
}

roll() {
  step "Rolling $SERVICE so every task reads the new $1"
  local rc=0; df_roll_service "$CLUSTER" "$SERVICE" "$REGION" || rc=$?
  case "$rc" in
    0) pass "Service stable" ;;
    1) die "update-service failed. The old $1 still works; re-run to carry on." ;;
    2) die "The new deployment failed and ECS rolled $SERVICE back. The old $1 still works, so nothing is broken by the rotation; fix the service and re-run to carry on." ;;
    *) die "$SERVICE did not stabilize. The old $1 still works, so nothing is broken by the rotation; fix the service and re-run to carry on." ;;
  esac
}

echo ""
echo "DevOpsFoundry — Rotate $WHICH"
echo "  config:  $CONFIG"
echo "  service: $CLUSTER / $SERVICE"
echo "─────────────────────────────────────"

if [[ "$WHICH" == redis ]]; then
  M='module\.app\.module\.cache\[0\]\.'
  GEN="$(df_tfvar "$TFV" cache_auth_token_generation)"; GEN="${GEN:-0}"
  [[ "$GEN" =~ ^[0-9]+$ ]] || die "cache_auth_token_generation in $TFV is not a whole number: $GEN"
  STRATEGY="$(df_tfvar "$TFV" cache_auth_token_update_strategy)"

  if [[ "$STRATEGY" == ROTATE ]]; then
    info "Token generation $GEN is already published; carrying on with the roll"
  else
    GEN=$((GEN + 1))
    step "1/3 Publish: new token (generation $GEN), the old one stays valid"
    apply_step "publish Redis token generation $GEN" \
      "^(${M}(random_password\.auth_token|aws_elasticache_replication_group\.main)|module\.app\.aws_secretsmanager_secret_version\.redis_auth\[0\])\$" \
      -var "cache_auth_token_generation=$GEN" -var "cache_auth_token_update_strategy=ROTATE"
    df_set_tfvar "$TFV" cache_auth_token_generation "$GEN"
    df_set_tfvar "$TFV" cache_auth_token_update_strategy '"ROTATE"'
    pass "Published"
  fi

  step "2/3 Roll"
  roll "Redis token"

  step "3/3 Retire: only generation $GEN's token is valid from now on"
  apply_step "retire the previous Redis token" "^${M}aws_elasticache_replication_group\.main\$" \
    -var "cache_auth_token_generation=$GEN" -var "cache_auth_token_update_strategy=SET"
  df_set_tfvar "$TFV" cache_auth_token_update_strategy '"SET"'
  pass "Retired"
  log "INFO" "Rotated the Redis auth token of $SERVICE (generation $GEN)"
else
  M='module\.app\.module\.email\[0\]\.'
  ACTIVE="$(df_tfvar "$TFV" smtp_active_key)"; ACTIVE="${ACTIVE:-a}"
  STANDBY="$(df_tfvar "$TFV" smtp_standby_key)"; STANDBY="${STANDBY:-none}"
  [[ "$ACTIVE" =~ ^[ab]$ ]] || die "smtp_active_key in $TFV must be a or b, not: $ACTIVE"
  [[ "$STANDBY" =~ ^(none|active|inactive)$ ]] || die "smtp_standby_key in $TFV must be none, active or inactive, not: $STANDBY"

  if [[ "$STANDBY" == active ]]; then
    info "SMTP key $ACTIVE is already published; carrying on with the roll"
  else
    NEW=$([[ "$ACTIVE" == a ]] && echo b || echo a)
    # A retired key in the new slot is replaced: IAM allows two keys per user.
    REPLACE=()
    [[ "$STANDBY" == inactive ]] && REPLACE=(-replace="module.app.module.email[0].aws_iam_access_key.ses_smtp[\"$NEW\"]")
    step "1/3 Publish: new SMTP key in slot $NEW, key $ACTIVE stays valid"
    apply_step "publish SMTP key $NEW" \
      "^${M}(aws_iam_access_key\.ses_smtp\[\"[ab]\"\]|aws_secretsmanager_secret_version\.smtp)\$" \
      -var "smtp_active_key=$NEW" -var "smtp_standby_key=active" ${REPLACE[@]+"${REPLACE[@]}"}
    df_set_tfvar "$TFV" smtp_active_key "\"$NEW\""
    df_set_tfvar "$TFV" smtp_standby_key '"active"'
    ACTIVE="$NEW"
    pass "Published"
    # A new IAM key can take a few seconds to be accepted everywhere.
    sleep "${DF_KEY_SETTLE_SECONDS:-15}"
  fi

  step "2/3 Roll"
  roll "SMTP password"

  step "3/3 Retire: the previous key becomes Inactive (kept until the next rotation)"
  apply_step "retire the previous SMTP key" "^${M}aws_iam_access_key\.ses_smtp\[\"[ab]\"\]\$" \
    -var "smtp_active_key=$ACTIVE" -var "smtp_standby_key=inactive"
  df_set_tfvar "$TFV" smtp_standby_key '"inactive"'
  pass "Retired"
  log "INFO" "Rotated the SMTP key of $SERVICE (slot $ACTIVE active)"
fi

echo "─────────────────────────────────────"
pass "Rotated. app.tfvars records the new state; commit it with the app."
