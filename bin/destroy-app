#!/usr/bin/env bash
# destroy-app — tear down an app's AWS resources and (by default) revert the
#               Namecheap nameserver delegation. Mirror of destroy-site.
#
# Usage: bin/destroy-app --config <dir> [--keep-ns] [--yes]
set -euo pipefail
DF_SCRIPT_NAME="destroy-app"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

CONFIG=""; KEEP_NS=false; YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)  CONFIG="$2"; shift 2 ;;
    --keep-ns) KEEP_NS=true; shift ;;
    --yes|-y)  YES=true; shift ;;
    *)         die "Unknown arg: $1" ;;
  esac
done
CONFIG="$(df_resolve_config "$CONFIG")"
TFVARS=(-var-file=app.tfvars)

if [[ -z "${NAMECHEAP_CLIENT_IP:-}" ]]; then
  NAMECHEAP_CLIENT_IP="$(df_detect_ip)"; export NAMECHEAP_CLIENT_IP
fi

DOMAIN=$(df_tf_at "$CONFIG" output -raw service_url 2>/dev/null | sed 's|https://[^.]*\.||' || echo "this app")
echo ""
echo "DevOpsFoundry — DESTROY app ($CONFIG)"
$KEEP_NS && echo "  (keeping Namecheap NS delegation)" || echo "  (reverting Namecheap NS to default)"
echo "─────────────────────────────────────"
if [[ "$YES" != true ]]; then
  read -r -p "Type DESTROY to confirm: " c; [[ "$c" == "DESTROY" ]] || { echo "Aborted."; exit 0; }
fi

if $KEEP_NS; then
  step "Dropping namecheap_ns from state (delegation persists)"
  df_tf_at "$CONFIG" state rm module.app.module.namecheap_ns 2>/dev/null || warn "namecheap_ns not in state"
fi

# An app handed off by release-nameservers has no Namecheap record in state, so
# destroy alone would leave the domain pointing at deleted Route53 nameservers.
# Re-adopt the record first (it rewrites the same nameservers, a no-op at
# Namecheap); destroying it then reverts the delegation as before.
EXTRA=()
if ! $KEEP_NS && [[ "$(df_tfvar "$CONFIG/app.tfvars" manage_nameservers)" == "false" ]] \
  && df_tf_at "$CONFIG" state list 2>/dev/null | grep -q '^module\.app\.module\.route53_zone\[0\]'; then
  step "Re-adopting the Namecheap delegation so destroy can revert it"
  df_tf_at "$CONFIG" apply -input=false -auto-approve "${TFVARS[@]}" -var manage_nameservers=true \
    -target=module.app.module.namecheap_ns || die "Could not re-adopt the delegation (Namecheap API access needed); use --keep-ns to destroy without reverting it"
  EXTRA=(-var manage_nameservers=true)
fi

step "terraform destroy"
df_tf_at "$CONFIG" destroy -input=false -auto-approve "${TFVARS[@]}" ${EXTRA[@]+"${EXTRA[@]}"}
log "INFO" "Destroyed app at $CONFIG (keep_ns=$KEEP_NS)"
pass "AWS resources destroyed"
info "App root kept at $CONFIG (state now empty). Remove the dir manually if done."
