#!/usr/bin/env bash
# destroy-app — tear down an app's AWS resources and (by default) revert the
#               Namecheap nameserver delegation. Mirror of destroy-site.
#
# Usage: bin/destroy-app --config <dir> [--keep-ns] [--yes]
#
# With NAMECHEAP_GATEWAY set (.env), the domain is reset to Namecheap's default
# DNS through the namecheap-gateway Lambda (bin/namecheap) before the stack is
# destroyed, so this machine needs no Namecheap key or allowlisted IP. A
# delegation the provider still manages is first dropped from state (that
# doesn't call Namecheap). NAMECHEAP_DIRECT=1 opts out.
set -euo pipefail
DF_SCRIPT_NAME="destroy-app"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

CONFIG=""; KEEP_NS=false; YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)  CONFIG="$2"; shift 2 ;;
    --keep-ns) KEEP_NS=true; shift ;;
    --yes|-y)  YES=true; shift ;;
    *)         die "Unknown arg: $1" ;;
  esac
done
CONFIG="$(df_resolve_config "$CONFIG")"
df_ensure_app_init "$CONFIG"
TFVARS=(-var-file=app.tfvars)

if ! df_gateway_on && [[ -z "${NAMECHEAP_CLIENT_IP:-}" ]]; then
  NAMECHEAP_CLIENT_IP="$(df_detect_ip)"; export NAMECHEAP_CLIENT_IP
fi

DOMAIN=$(df_tf_at "$CONFIG" output -raw service_url 2>/dev/null | sed 's|https://[^.]*\.||' || echo "this app")
echo ""
echo "DevOpsFoundry — DESTROY app ($CONFIG)"
if $KEEP_NS; then echo "  (keeping Namecheap NS delegation)"
elif df_gateway_on; then echo "  (reverting Namecheap NS to default through the gateway $NAMECHEAP_GATEWAY)"
else echo "  (reverting Namecheap NS to default)"; fi
echo "─────────────────────────────────────"
if [[ "$YES" != true ]]; then
  read -r -p "Type DESTROY to confirm: " c; [[ "$c" == "DESTROY" ]] || { echo "Aborted."; exit 0; }
fi

if $KEEP_NS; then
  step "Dropping namecheap_ns from state (delegation persists)"
  df_tf_at "$CONFIG" state rm module.app.module.namecheap_ns 2>/dev/null || warn "namecheap_ns not in state"
  df_app_namecheap_provider "$CONFIG" unused || die "Nothing destroyed."
fi

# An app handed off by release-nameservers has no Namecheap record in state, so
# destroy alone would leave the domain pointing at deleted Route53 nameservers.
# Re-adopt the record first (it rewrites the same nameservers, a no-op at
# Namecheap); destroying it then reverts the delegation as before.
EXTRA=()
if ! $KEEP_NS && df_gateway_on; then
  STATE="$(df_tf_at "$CONFIG" state list 2>/dev/null)" || die "Could not read Terraform state in $CONFIG"
  ADDR="$(grep -E "$DF_NS_RECORD_RE" <<<"$STATE" | head -1 || true)"
  if [[ -n "$ADDR" ]]; then
    # Out of state without a Namecheap call; the gateway resets the domain instead.
    step "Dropping the Namecheap record from state (the gateway resets the domain instead)"
    df_tf_at "$CONFIG" state rm "$ADDR" >/dev/null || die "terraform state rm failed; nothing destroyed"
    df_app_namecheap_provider "$CONFIG" unused || die "Nothing destroyed."
  fi
  if grep -qE "$DF_ZONE_RE" <<<"$STATE"; then
    APP_DOMAIN="$(df_tfvar "$CONFIG/app.tfvars" domain_name)"
    [[ -n "$APP_DOMAIN" ]] || die "No domain_name in $CONFIG/app.tfvars; nothing destroyed"
    step "Resetting $APP_DOMAIN to Namecheap's default DNS through the gateway"
    df_gateway reset "$APP_DOMAIN" --yes || die "Could not reset $APP_DOMAIN through the gateway; nothing destroyed. Use --keep-ns to destroy without resetting it"
  else
    info "No Route53 zone of this app's in state, so its domain's nameservers are left as they are"
  fi
elif ! $KEEP_NS && [[ "$(df_tfvar "$CONFIG/app.tfvars" manage_nameservers)" == "false" ]] \
  && df_tf_at "$CONFIG" state list 2>/dev/null | grep -qE "$DF_ZONE_RE"; then
  step "Re-adopting the Namecheap delegation so destroy can revert it"
  # The released root's namecheap.tf has placeholders; reverting needs the real credentials.
  df_app_namecheap_provider "$CONFIG" live || die "Nothing destroyed."
  if ! df_tf_at "$CONFIG" apply -input=false -auto-approve "${TFVARS[@]}" -var manage_nameservers=true \
    -target=module.app.module.namecheap_ns; then
    df_app_namecheap_provider "$CONFIG" unused
    die "Could not re-adopt the delegation (Namecheap API access needed); use --keep-ns to destroy without reverting it"
  fi
  EXTRA=(-var manage_nameservers=true)
fi

step "terraform destroy"
df_tf_at "$CONFIG" destroy -input=false -auto-approve "${TFVARS[@]}" ${EXTRA[@]+"${EXTRA[@]}"}
log "INFO" "Destroyed app at $CONFIG (keep_ns=$KEEP_NS)"
pass "AWS resources destroyed"
info "App root kept at $CONFIG (state now empty). Remove the dir manually if done."
