#!/usr/bin/env bash
# destroy-site — tear down a site's AWS resources and (by default) revert the
#                Namecheap nameserver delegation back to Namecheap's default.
#
# Deleting the namecheap_domain_records resource reverts the domain to default
# nameservers. Use --keep-ns to leave the delegation in place (drops it from
# state before destroy) so the domain keeps pointing at a now-empty zone.
#
# Usage: bin/destroy-site --config <dir> [--keep-ns] [--purge] [--yes]
#        bin/destroy-site <domain>       [--keep-ns] [--purge] [--yes]   (root in sites/<domain>)
#
# A site released by bin/release-nameservers (namecheap.tf renamed to
# namecheap.tf.released) has no Namecheap record in state. To revert, the file
# comes back and the record is re-adopted first (it rewrites the same
# nameservers, a no-op at Namecheap); with --keep-ns the file stays aside.
#
# A site made with new-site --existing-zone (existing_zone_id in its
# terraform.tfvars) removes only its own records from that zone: the zone and
# its nameservers stay, Namecheap is never called, and --keep-ns is refused.
#
# --purge removes the site root. With --config that is the repo's
# .devopsfoundry/ directory, so it is only removed after the typed confirmation.
set -euo pipefail
DF_SCRIPT_NAME="destroy-site"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

DOMAIN=""; CONFIG=""; KEEP_NS=false; PURGE=false; YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)  CONFIG="$2"; shift 2 ;;
    --keep-ns) KEEP_NS=true; shift ;;
    --purge)   PURGE=true; shift ;;
    --yes|-y)  YES=true; shift ;;
    -*)        die "Unknown flag: $1" ;;
    *) DOMAIN="$1"; shift ;;
  esac
done
if [[ -n "$CONFIG" ]]; then
  [[ -z "$DOMAIN" ]] || die "Pass --config or a domain, not both"
  SITE_DIR="$(df_resolve_site_config "$CONFIG")"
  DOMAIN="$(df_tfvar "$SITE_DIR/terraform.tfvars" domain_name)"
  df_validate_domain "$DOMAIN"
  df_ensure_app_init "$SITE_DIR"
  $PURGE && $YES && die "--purge with --config deletes $SITE_DIR from its repo; run it without --yes and confirm"
else
  df_validate_domain "$DOMAIN"
  SITE_DIR="$(df_site_dir "$DOMAIN")"
  [[ -d "$SITE_DIR" ]] || die "No site dir for $DOMAIN"
fi

ZONE_ID=""
[[ -f "$SITE_DIR/terraform.tfvars" ]] && ZONE_ID="$(df_tfvar "$SITE_DIR/terraform.tfvars" existing_zone_id)"
if [[ -n "$ZONE_ID" ]]; then
  $KEEP_NS && die "--keep-ns doesn't apply: this site's zone $ZONE_ID existed before it, and its nameservers are never changed"
else
  # Namecheap provider needs a client IP even for destroy.
  if [[ -z "${NAMECHEAP_CLIENT_IP:-}" ]]; then
    NAMECHEAP_CLIENT_IP="$(df_detect_ip)"; export NAMECHEAP_CLIENT_IP
  fi
fi

echo ""
echo "DevOpsFoundry — DESTROY $DOMAIN"
if [[ -n "$ZONE_ID" ]]; then
  echo "  (removing only this site's records from zone $ZONE_ID; the zone and its nameservers stay)"
elif $KEEP_NS; then echo "  (keeping Namecheap NS delegation)"
else echo "  (reverting Namecheap NS to default)"; fi
echo "─────────────────────────────────────"
if [[ "$YES" != true ]]; then
  read -r -p "Type the domain to confirm destroy: " c
  [[ "$c" == "$DOMAIN" ]] || { echo "Aborted."; exit 0; }
fi

if $KEEP_NS; then
  step "Dropping namecheap_ns from state (delegation will persist)"
  df_tf_at "$SITE_DIR" state rm module.namecheap_ns 2>/dev/null || warn "namecheap_ns not in state"
elif [[ -z "$ZONE_ID" && -f "$SITE_DIR/namecheap.tf.released" && ! -f "$SITE_DIR/namecheap.tf" ]]; then
  step "Re-adopting the Namecheap delegation so destroy can revert it"
  mv "$SITE_DIR/namecheap.tf.released" "$SITE_DIR/namecheap.tf"
  if ! df_tf_at "$SITE_DIR" apply -input=false -auto-approve -target=module.namecheap_ns; then
    mv "$SITE_DIR/namecheap.tf" "$SITE_DIR/namecheap.tf.released"
    die "Could not re-adopt the delegation (Namecheap API access needed); use --keep-ns to destroy without reverting it"
  fi
fi

step "terraform destroy"
df_tf_at "$SITE_DIR" destroy -input=false -auto-approve
log "INFO" "Destroyed $DOMAIN (keep_ns=$KEEP_NS${ZONE_ID:+, existing zone $ZONE_ID kept})"
pass "AWS resources destroyed"

if $PURGE; then
  rm -rf "$SITE_DIR"
  pass "Removed site dir ${SITE_DIR/$HOME/\~}"
else
  info "Site dir kept at ${SITE_DIR/$HOME/\~} (state now empty). Use --purge to remove."
fi
