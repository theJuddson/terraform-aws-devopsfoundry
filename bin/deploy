#!/usr/bin/env bash
# deploy — build (optional) + sync a site's static files to S3 + invalidate
#          CloudFront. Reads sites/<domain>/site.env for BUILD_DIR/BUILD_CMD.
#
# Usage: bin/deploy <domain> [--yes] [--allow-stale]
#
# Without a BUILD_CMD, BUILD_DIR is uploaded as it is, so deploy first checks it
# is at least as new as its source (SRC_DIR, else BUILD_DIR's parent, plus any
# BUILD_INPUTS) and stops before uploading if a source file changed after the
# last build. --allow-stale deploys anyway.
set -euo pipefail
DF_SCRIPT_NAME="deploy"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

DOMAIN=""; YES=false; ALLOW_STALE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y)      YES=true; shift ;;
    --allow-stale) ALLOW_STALE=true; shift ;;
    -*)            die "Unknown flag: $1" ;;
    *)             DOMAIN="$1"; shift ;;
  esac
done
df_validate_domain "$DOMAIN"

SITE_DIR="$(df_site_dir "$DOMAIN")"
[[ -d "$SITE_DIR" ]] || die "No site dir for $DOMAIN — run: bin/new-site $DOMAIN"
[[ -f "$SITE_DIR/site.env" ]] || die "Missing $SITE_DIR/site.env"
# shellcheck disable=SC1091
source "$SITE_DIR/site.env"

echo ""
echo "DevOpsFoundry — Deploy $DOMAIN"
echo "─────────────────────────────────────"

# ── Read infra coordinates from this site's terraform state ──
step "Reading Terraform outputs"
BUCKET=$(df_tf "$DOMAIN" output -raw bucket 2>/dev/null)   || die "Could not read 'bucket' output — is the site provisioned?"
DIST=$(df_tf "$DOMAIN" output -raw cloudfront_id 2>/dev/null) || die "Could not read 'cloudfront_id' output"
URL=$(df_tf "$DOMAIN" output -raw url 2>/dev/null)         || die "Could not read 'url' output"
pass "Bucket: $BUCKET"
pass "Distribution: $DIST"

# ── Optional build ─────────────────────────────────────
if [[ -n "${BUILD_CMD:-}" ]]; then
  run_dir="${SRC_DIR:-$(dirname "$BUILD_DIR")}"
  step "Building in $run_dir: $BUILD_CMD"
  ( cd "$run_dir" && eval "$BUILD_CMD" ) || die "Build failed"
  pass "Build complete"
fi

[[ -d "$BUILD_DIR" ]] || die "BUILD_DIR not found: $BUILD_DIR (set it in $SITE_DIR/site.env)"

# ── Is the upload what the source says it should be? ──
SRC="${SRC_DIR:-$(dirname "$BUILD_DIR")}"
[[ -d "$SRC" ]] || die "SRC_DIR not found: $SRC (set it in $SITE_DIR/site.env)"
if [[ -n "${BUILD_CMD:-}" ]]; then
  :   # built just now
elif [[ "$ALLOW_STALE" == true ]]; then
  warn "Not checking that $BUILD_DIR is newer than its source (--allow-stale)"
else
  step "Checking $BUILD_DIR is newer than its source ($SRC${BUILD_INPUTS:+ + $BUILD_INPUTS})"
  # shellcheck disable=SC2086  # BUILD_INPUTS is a space-separated list
  FRESHNESS="$(df_build_freshness "$BUILD_DIR" "$SRC" ${BUILD_INPUTS:-})"
  case "$FRESHNESS" in
    FRESH*)   pass "Build is newer than its source (newest source file: ${FRESHNESS#FRESH })" ;;
    SELF)     pass "BUILD_DIR is its own source (SRC_DIR = BUILD_DIR); nothing to compare" ;;
    EMPTY)    die "$BUILD_DIR holds no files; build the site first" ;;
    MISSING*) die "BUILD_INPUTS path not found: ${FRESHNESS#MISSING } (set in $SITE_DIR/site.env)" ;;
    STALE*)   die "$BUILD_DIR is older than its source: ${FRESHNESS#STALE } changed after the last build. Rebuild it (or set BUILD_CMD in $SITE_DIR/site.env so deploy builds first), then deploy again; --allow-stale deploys it anyway. Nothing was uploaded." ;;
    *)        die "Could not compare $BUILD_DIR with its source: $FRESHNESS" ;;
  esac
fi
if df_git_dirty "$SRC"; then
  warn "Uncommitted changes in $SRC: the live site won't match any commit"
fi

[[ -f "$BUILD_DIR/index.html" ]] || warn "No index.html in $BUILD_DIR — SPA fallback may 404"
SIZE=$(du -sh "$BUILD_DIR" | cut -f1)
pass "Deploying $BUILD_DIR ($SIZE)"

if [[ "$YES" != true ]]; then
  read -r -p "Deploy to $URL? (y/N) " c; [[ "$c" == [yY] ]] || { echo "Aborted."; exit 0; }
fi

# ── Upload. A file's cache header follows its name ─────
#   hashed assets (index-B4kq9z1x.js)  a year, immutable: the name changes with the content
#   *.html                             never cached
#   everything else (styles.css, logo.png, robots.txt)  cached but revalidated on every
#     request, so an edit shows on the next visit and an unchanged file costs a 304
# Assets go up before the HTML that points at them, and old files are deleted last.
# Unhashed files are copied every time rather than synced: sync skips a file whose
# content hasn't changed, which would leave an old cache header on it.
HASHED=()
while IFS= read -r f; do HASHED+=("$f"); done < <(df_hashed_assets "$BUILD_DIR")
SKIP_HASHED=()
for f in ${HASHED[@]+"${HASHED[@]}"}; do SKIP_HASHED+=(--exclude "$f"); done

if [[ ${#HASHED[@]} -gt 0 ]]; then
  step "Syncing ${#HASHED[@]} hashed asset(s) (cached for a year)"
  ONLY_HASHED=(--exclude "*")
  for f in "${HASHED[@]}"; do ONLY_HASHED+=(--include "$f"); done
  OUT=$(aws s3 sync "$BUILD_DIR" "s3://$BUCKET" "${ONLY_HASHED[@]}" \
    --cache-control "max-age=31536000,public,immutable" 2>&1) \
    || die "S3 sync of hashed assets failed: $OUT"
  pass "Hashed assets synced"
fi

step "Uploading other assets (revalidated on every request)"
OUT=$(aws s3 cp "$BUILD_DIR" "s3://$BUCKET" --recursive \
  --exclude "*.html" ${SKIP_HASHED[@]+"${SKIP_HASHED[@]}"} \
  --cache-control "no-cache" 2>&1) \
  || die "Asset upload failed: $OUT"
pass "Other assets uploaded"

step "Uploading HTML (never cached)"
OUT=$(aws s3 cp "$BUILD_DIR" "s3://$BUCKET" --recursive \
  --exclude "*" --include "*.html" \
  --cache-control "no-cache,no-store,must-revalidate" \
  --content-type "text/html" 2>&1) || die "HTML upload failed: $OUT"
pass "HTML uploaded"

# Everything is uploaded now, so sizes match and this only deletes what the build no longer has
step "Removing files no longer in the build"
OUT=$(aws s3 sync "$BUILD_DIR" "s3://$BUCKET" --delete --size-only 2>&1) \
  || die "S3 cleanup failed: $OUT"
pass "Old files removed"

# ── Invalidate CloudFront ──────────────────────────────
step "Invalidating CloudFront"
INV=$(aws cloudfront create-invalidation --distribution-id "$DIST" --paths "/*" 2>&1) \
  || die "Invalidation failed: $INV"
pass "Invalidation: $(echo "$INV" | jq -r '.Invalidation.Id')"
log "INFO" "Deployed $DOMAIN"

echo ""
echo "─────────────────────────────────────"
pass "Deployed — live at $URL (CloudFront propagation ~1-2 min)"
