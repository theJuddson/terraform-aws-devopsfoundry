#!/usr/bin/env bash
# preflight — verify the local toolchain + AWS + Namecheap prerequisites.
#
# Usage: bin/preflight [--config <dir>] [--existing-zone]
#   --config checks the state backend that root uses (its backend.tfvars, else
#     this checkout's).
#   --existing-zone skips the Namecheap checks, for new-site --existing-zone,
#     which never calls Namecheap.
set -euo pipefail
DF_SCRIPT_NAME="preflight"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

CONFIG=""; EXISTING_ZONE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)        CONFIG="$2"; shift 2 ;;
    --existing-zone) EXISTING_ZONE=true; shift ;;
    *)               die "Unknown arg: $1 (usage: bin/preflight [--config <dir>] [--existing-zone])" ;;
  esac
done

# Optional: set DF_EXPECTED_AWS_ACCOUNT in .env to catch the wrong AWS_PROFILE.
EXPECTED_ACCOUNT="${DF_EXPECTED_AWS_ACCOUNT:-}"
fails=0

echo ""
echo "DevOpsFoundry — Preflight"
echo "─────────────────────────────────────"

# ── Tooling ────────────────────────────────────────────
for tool in aws terraform jq dig curl git; do
  if command -v "$tool" &>/dev/null; then pass "$tool installed"
  else warn "$tool missing"; fails=$((fails + 1)); fi
done
echo "  terraform: $(terraform version -json 2>/dev/null | jq -r .terraform_version 2>/dev/null || terraform version | head -1)"

# ── AWS ────────────────────────────────────────────────
# An expired sign-in (aws login, IAM Identity Center) and missing credentials
# need different fixes, so say which it is (#58).
PROFILE="${AWS_PROFILE:-default}"
if STS_ERR="$(aws sts get-caller-identity --query Account --output text 2>&1)"; then
  ACCT="$STS_ERR"
  if [[ -z "$EXPECTED_ACCOUNT" || "$ACCT" == "$EXPECTED_ACCOUNT" ]]; then pass "AWS account: $ACCT"
  else warn "AWS account is $ACCT (expected $EXPECTED_ACCOUNT — check AWS_PROFILE)"; fi
  # Masked by the CLI: only the credential source is read, never the key.
  # Newer CLIs separate the columns with " : ", older ones with spaces.
  KEY_SOURCE="$(aws configure list 2>/dev/null | awk '/^[[:space:]]*access_key/ {
    if (index($0, ":")) { split($0, f, ":"); t = f[3] } else { t = $3 }
    gsub(/[[:space:]]/, "", t); print t }')"
  if [[ "$KEY_SOURCE" == shared-credentials-file ]]; then
    info "Profile $PROFILE uses long-term access keys from ~/.aws/credentials; aws login or IAM Identity Center gives short-lived ones"
  fi
else
  ACCT=""
  case "$STS_ERR" in
    # ExpiredToken(Exception), "token ... is expired", "Token has expired", and an
    # SSO token that can't be refreshed.
    *[Ee]xpired*|*"Error when retrieving token from sso"*)
      warn "AWS sign-in for profile $PROFILE has expired. Run: aws login --profile $PROFILE (or aws sso login --profile $PROFILE for IAM Identity Center)" ;;
    *"Unable to locate credentials"*|*"could not be found"*)
      warn "No AWS credentials for profile $PROFILE. Sign in: aws login --profile $PROFILE (or aws configure sso), and set AWS_PROFILE in .env" ;;
    *)
      warn "AWS rejected the credentials for profile $PROFILE: $(head -1 <<<"$STS_ERR" | sed 's/^[[:space:]]*//')" ;;
  esac
  fails=$((fails + 1))
fi

# ── SES (informational: only apps with --enable-email send mail) ──
SES_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-$(aws configure get region 2>/dev/null || true)}}"
if [[ -n "$SES_REGION" ]] && [[ -n "${ACCT:-}" ]]; then
  df_ses_report "$SES_REGION" "$(df_ses_account_status "$SES_REGION")"
fi

# ── Secret age (informational: bin/rotate-secret rotates them) ──
if [[ -n "$SES_REGION" ]] && [[ -n "${ACCT:-}" ]]; then
  df_secret_age_report "$SES_REGION"
fi

# ── State backend reachability ─────────────────────────
BACKEND_FILE="$DF_ROOT/backend.tfvars"
[[ -z "$CONFIG" ]] || BACKEND_FILE="$(df_app_backend_file "$CONFIG")"
[[ -f "$BACKEND_FILE" ]] || die "No backend.tfvars. Copy backend.tfvars.example to backend.tfvars${CONFIG:+ (here, or in $CONFIG)} and fill in your state bucket."
BACKEND_BUCKET=$(awk -F'"' '/^[[:space:]]*bucket[[:space:]]*=/{print $2}' "$BACKEND_FILE")
if aws s3api head-bucket --bucket "$BACKEND_BUCKET" &>/dev/null; then
  pass "State bucket reachable: $BACKEND_BUCKET"
else
  warn "State bucket not reachable: $BACKEND_BUCKET"; fails=$((fails + 1))
fi

# ── Namecheap ──────────────────────────────────────────
if $EXISTING_ZONE; then
  info "Namecheap not checked: an existing zone (--existing-zone) never calls it"
else
  nc_ok=true
  for v in NAMECHEAP_USER_NAME NAMECHEAP_API_USER NAMECHEAP_API_KEY; do
    if [[ -z "${!v:-}" ]]; then warn "$v not set (see .env.example)"; nc_ok=false; fi
  done
  $nc_ok && pass "Namecheap API creds present"
  [[ "${NAMECHEAP_USE_SANDBOX:-false}" == "true" ]] && info "Namecheap SANDBOX mode is ON"

  # IP whitelist check — the machine's public IP must be whitelisted at Namecheap.
  PUBLIC_IP=$(df_detect_ip)
  CLIENT_IP="${NAMECHEAP_CLIENT_IP:-}"
  if [[ -n "$PUBLIC_IP" ]]; then
    pass "Public IPv4: $PUBLIC_IP"
    if [[ -z "$CLIENT_IP" ]]; then
      info "NAMECHEAP_CLIENT_IP unset — scripts will auto-use $PUBLIC_IP"
      warn "Confirm $PUBLIC_IP is whitelisted: Namecheap → Profile → Tools → API → Whitelisted IPs"
    elif [[ "$CLIENT_IP" != "$PUBLIC_IP" ]]; then
      warn "NAMECHEAP_CLIENT_IP ($CLIENT_IP) != detected public IP ($PUBLIC_IP) — API calls will fail unless on a static/VPN IP"
    else
      pass "NAMECHEAP_CLIENT_IP matches public IP"
    fi
  else
    warn "Could not detect public IP (offline?) — ensure NAMECHEAP_CLIENT_IP is set + whitelisted"
  fi
fi

echo "─────────────────────────────────────"
if [[ "$fails" -eq 0 ]]; then
  pass "Preflight OK"
else
  warn "$fails hard check(s) failed — resolve before provisioning"
  exit 1
fi
