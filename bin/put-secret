#!/usr/bin/env bash
# put-secret — store an app secret (an API key, an OAuth client secret, ...) in
#              Secrets Manager without the value reaching shell history, the
#              process list or a chat transcript.
#
# Usage: bin/put-secret <name> [--description TEXT] [--env ENV_NAME] [--region R]
#                       [--kms-key KEY] [--app APP]
#   Prompts twice with hidden input, or reads the value from stdin when piped:
#     bin/put-secret myapp/stripe --env STRIPE_KEY
#     pbpaste | bin/put-secret myapp/stripe
#   Creates the secret, or adds a new current version if it already exists, and
#   prints its ARN (with --env, as the line to put in app.tfvars `secrets`).
#   --kms-key encrypts it with a customer managed key (ARN, alias/... or key ID)
#   instead of the AWS-managed one; give the app's tasks that key through
#   container-service's secrets_kms_key_arns. Every secret is tagged
#   Project=devopsfoundry and App=<app> (--app, else the name's first segment),
#   so inventory, cost and age reports can find it (#56).
set -euo pipefail
DF_SCRIPT_NAME="put-secret"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

NAME=""; DESCRIPTION=""; ENV_NAME=""; REGION="${AWS_REGION:-us-east-1}"; KMS_KEY=""; APP=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --description) DESCRIPTION="$2"; shift 2 ;;
    --env)         ENV_NAME="$2"; shift 2 ;;
    --region)      REGION="$2"; shift 2 ;;
    --kms-key)     KMS_KEY="$2"; shift 2 ;;
    --app)         APP="$2"; shift 2 ;;
    -*)            die "Unknown flag: $1" ;;
    *)             [[ -z "$NAME" ]] || die "One secret name only (got '$NAME' and '$1')"; NAME="$1"; shift ;;
  esac
done
[[ -n "$NAME" ]] || die "Usage: bin/put-secret <name> [--description TEXT] [--env ENV_NAME] [--region R]"
[[ "$NAME" =~ ^[A-Za-z0-9/_+=.@-]+$ ]] || die "Secret names may use letters, digits and / _ + = . @ - only"
[[ -z "$ENV_NAME" || "$ENV_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "--env must be an environment variable name"
[[ -z "$KMS_KEY" || "$KMS_KEY" =~ ^(arn:aws[a-z-]*:kms:[a-z0-9-]+:[0-9]{12}:(key|alias)/[A-Za-z0-9/_-]+|alias/[A-Za-z0-9/_-]+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$ ]] \
  || die "--kms-key must be a KMS key ARN, alias/<name> or key ID"
if [[ -z "$APP" && "$NAME" == */* ]]; then APP="${NAME%%/*}"; fi
[[ -z "$APP" || "$APP" =~ ^[A-Za-z0-9_.:/=+@-]{1,128}$ ]] || die "--app may use letters, digits and _ . : / = + @ - only"
TAGS=("Key=Project,Value=devopsfoundry")
[[ -n "$APP" ]] && TAGS+=("Key=App,Value=$APP")

# Read the value into a variable only. printf is a bash builtin, so passing it on
# below starts no process whose arguments would show the value.
if [[ -t 0 ]]; then
  read -r -s -p "Value for $NAME (hidden): " VALUE; echo >&2
  read -r -s -p "Again, to confirm: " AGAIN; echo >&2
  [[ "$VALUE" == "$AGAIN" ]] || die "The two entries differ; nothing stored"
  unset AGAIN
else
  VALUE="$(cat)"   # drops trailing newlines, e.g. from echo
fi
[[ -n "$VALUE" ]] || die "Empty value; nothing stored"

if DELETED="$(aws secretsmanager describe-secret --secret-id "$NAME" --region "$REGION" \
      --query 'DeletedDate' --output text 2>/dev/null)"; then
  [[ -z "$DELETED" || "$DELETED" == "None" ]] \
    || die "$NAME is scheduled for deletion; restore it first: aws secretsmanager restore-secret --secret-id $NAME --region $REGION"
  # Before the value, so the new version is encrypted with the new key. Earlier
  # versions keep the key they were stored with.
  if [[ -n "$KMS_KEY" ]]; then
    aws secretsmanager update-secret --secret-id "$NAME" --region "$REGION" --kms-key-id "$KMS_KEY" >/dev/null \
      || die "Could not set $NAME's KMS key to $KMS_KEY; nothing stored"
  fi
  ARN="$(printf '%s' "$VALUE" | aws secretsmanager put-secret-value --secret-id "$NAME" --region "$REGION" \
      --secret-string file:///dev/stdin --query ARN --output text)" || die "Could not store a new version of $NAME"
  unset VALUE
  aws secretsmanager tag-resource --secret-id "$NAME" --region "$REGION" --tags "${TAGS[@]}" >/dev/null \
    || warn "Stored, but could not tag $NAME (needs secretsmanager:TagResource)"
  pass "Stored a new current version of $NAME"
else
  ARGS=(--name "$NAME" --region "$REGION")
  [[ -n "$DESCRIPTION" ]] && ARGS+=(--description "$DESCRIPTION")
  [[ -n "$KMS_KEY" ]] && ARGS+=(--kms-key-id "$KMS_KEY")
  ARGS+=(--tags "${TAGS[@]}")
  ARN="$(printf '%s' "$VALUE" | aws secretsmanager create-secret "${ARGS[@]}" \
      --secret-string file:///dev/stdin --query ARN --output text)" || die "Could not create $NAME"
  unset VALUE
  pass "Created $NAME"
fi
log "INFO" "Stored secret $NAME"

if [[ -n "$ENV_NAME" ]]; then
  echo "Add to secrets = { ... } in app.tfvars:"
  echo "  $ENV_NAME = \"$ARN\""
else
  echo "$ARN"
fi
