#!/usr/bin/env bash
# namecheap — Namecheap nameserver calls through the namecheap-gateway Lambda, so
#             they leave from its fixed, allowlisted IP whatever network this
#             machine is on. The machine needs permission to invoke the function,
#             not the Namecheap key or an allowlisted address.
#
# Usage:
#   bin/namecheap check                       # the gateway reaches Namecheap with the key
#   bin/namecheap get <domain>                # nameservers, and whether Namecheap DNS is used
#   bin/namecheap set <domain> <ns> <ns>...   # custom nameservers (asks first)
#   bin/namecheap reset <domain>              # Namecheap's default DNS (asks first)
#   bin/namecheap put-key [-]                 # store the API key as the gateway's SSM SecureString
#
#   --yes skips the question for set and reset, once the person has seen the change and agreed.
#
# Settings (.env):
#   NAMECHEAP_GATEWAY            the function (default devopsfoundry-namecheap)
#   NAMECHEAP_GATEWAY_REGION     its region (default AWS_REGION, else us-east-1)
#   NAMECHEAP_KEY_PARAMETER      the key's parameter (default /devopsfoundry/namecheap/api-key)
#   NAMECHEAP_KEY_KMS_KEY        customer managed key for it (default the AWS-managed aws/ssm)
#
# put-key reads NAMECHEAP_API_KEY from .env, or the key from stdin with `-`. It
# reaches aws on stdin only, never in a command line, a log or this output.
set -euo pipefail
DF_SCRIPT_NAME="namecheap"
source "$(cd "$(dirname "$0")/.." && pwd)/lib/common.sh"
df_load_env

FUNCTION="${NAMECHEAP_GATEWAY:-devopsfoundry-namecheap}"
REGION="${NAMECHEAP_GATEWAY_REGION:-${AWS_REGION:-us-east-1}}"
PARAMETER="${NAMECHEAP_KEY_PARAMETER:-/devopsfoundry/namecheap/api-key}"

usage() { sed -n '/^# Usage:/,/^# Settings/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit "${1:-1}"; }

YES=false; ARGS=()
for a in "$@"; do
  case "$a" in
    --yes) YES=true ;;
    -h|--help) usage 0 ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
[[ $# -gt 0 ]] || usage
CMD="$1"; shift

confirm() {
  $YES && return 0
  # read -p shows nothing when the answer is piped in, so the question goes to stderr.
  local c; printf '%s (y/N) ' "$1" >&2
  read -r c || c=""
  [[ "$c" =~ ^[Yy]$ ]] || die "Nothing changed."
}

# Invokes the gateway with a JSON event and prints its JSON result. A failure in
# the function (a refused request, a Namecheap error) exits with its message.
invoke() {
  local out meta err
  out="$(mktemp)"
  meta="$(aws lambda invoke --function-name "$FUNCTION" --region "$REGION" \
      --cli-binary-format raw-in-base64-out --payload "$1" --output json "$out" 2>&1)" || {
    rm -f "$out"
    die "Could not invoke $FUNCTION in $REGION: $meta"
  }
  if [[ "$(jq -r '.FunctionError // empty' <<<"$meta")" != "" ]]; then
    err="$(jq -r '.errorMessage // "no message"' "$out" 2>/dev/null || cat "$out")"
    rm -f "$out"
    die "The gateway refused or failed: $err"
  fi
  cat "$out"; rm -f "$out"
}

need_domain() { [[ $# -ge 1 ]] || usage; df_validate_domain "$1"; }

case "$CMD" in
  check)
    r="$(invoke '{"action":"check"}')"
    pass "Namecheap answers the gateway ($FUNCTION) from $(jq -r .client_ip <<<"$r")"
    ;;

  get)
    need_domain "$@"
    invoke "$(jq -cn --arg d "$1" '{action:"get_nameservers",domain:$d}')" | jq .
    ;;

  set)
    need_domain "$@"
    domain="$1"; shift
    [[ $# -ge 2 ]] || die "Give at least two nameservers"
    payload="$(jq -cn --arg d "$domain" '{action:"set_nameservers",domain:$d,nameservers:$ARGS.positional}' --args "$@")"
    echo "  $domain nameservers -> $*"
    confirm "Point $domain at these nameservers at Namecheap?"
    invoke "$payload" | jq .
    log "INFO" "Set $domain nameservers to $* through $FUNCTION"
    pass "$domain now uses: $*"
    ;;

  reset)
    need_domain "$@"
    echo "  $1 -> Namecheap's default DNS (BasicDNS); any custom nameservers are dropped"
    confirm "Reset $1 to Namecheap's default DNS?"
    invoke "$(jq -cn --arg d "$1" '{action:"reset_default",domain:$d}')" | jq .
    log "INFO" "Reset $1 to Namecheap default DNS through $FUNCTION"
    pass "$1 now uses Namecheap's default DNS"
    ;;

  put-key)
    if [[ "${1:-}" == "-" ]]; then
      KEY="$(cat)"
    else
      KEY="${NAMECHEAP_API_KEY:-}"
      [[ -n "$KEY" ]] || die "NAMECHEAP_API_KEY is not set in .env; or pipe the key in: ... | bin/namecheap put-key -"
    fi
    [[ -n "$KEY" ]] || die "Empty key; nothing stored"
    KMS=()
    [[ -n "${NAMECHEAP_KEY_KMS_KEY:-}" ]] && KMS=(--key-id "$NAMECHEAP_KEY_KMS_KEY")
    exists="$(aws ssm describe-parameters --region "$REGION" \
      --parameter-filters "Key=Name,Values=$PARAMETER" --query 'length(Parameters)' --output text)" \
      || die "Could not look up $PARAMETER in $REGION"
    # printf is a builtin: the key starts no process whose arguments would show it.
    if [[ "$exists" == "0" ]]; then
      printf '%s' "$KEY" | aws ssm put-parameter --region "$REGION" --name "$PARAMETER" --type SecureString \
        ${KMS[@]+"${KMS[@]}"} --description "Namecheap API key for the DevOpsFoundry namecheap-gateway" \
        --tags Key=Project,Value=devopsfoundry --value file:///dev/stdin >/dev/null \
        || die "Could not create $PARAMETER"
      pass "Created $PARAMETER (SecureString) in $REGION"
    else
      printf '%s' "$KEY" | aws ssm put-parameter --region "$REGION" --name "$PARAMETER" --type SecureString \
        ${KMS[@]+"${KMS[@]}"} --overwrite --value file:///dev/stdin >/dev/null \
        || die "Could not update $PARAMETER"
      pass "Stored a new version of $PARAMETER in $REGION"
    fi
    unset KEY
    log "INFO" "Stored the Namecheap API key in $PARAMETER"
    ;;

  *) usage ;;
esac
