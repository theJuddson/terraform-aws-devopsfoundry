#!/usr/bin/env bash
# Static checks for every Terraform module and example: fmt, validate, tflint,
# checkov. Makes no AWS call (validate runs with -backend=false). Used by CI.
#
#   bin/check-modules                 # everything
#   bin/check-modules modules/kms-key # one or more directories
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-$HOME/.terraform.d/plugin-cache}"
mkdir -p "$TF_PLUGIN_CACHE_DIR"

if [[ $# -gt 0 ]]; then
  dirs=("$@")
else
  dirs=()
  dirs+=(".")   # the empty root module the Terraform Registry requires
  for d in modules/*/ examples/*/; do [[ -d "$d" ]] && dirs+=("${d%/}"); done
fi

fail=0
LEGACY_MODULES="acm-cert cache container-service database email full-stack namecheap-ns networking route53-records route53-zone shared-platform static-site"
step() { printf '\n== %s: %s\n' "$1" "$2"; }

terraform fmt -check -recursive modules examples tests || { echo "terraform fmt -check failed (run: terraform fmt -recursive modules examples tests)"; fail=1; }

tflint --init --config "$ROOT/.tflint.hcl" >/dev/null

for d in "${dirs[@]}"; do
  # A module that needs aliased providers from its caller is validated through
  # its wrapper under tests/validate/.
  vdir="$d"
  if grep -q configuration_aliases "$d"/*.tf 2>/dev/null; then
    vdir="tests/validate/$(basename "$d")"
    [[ -d "$vdir" ]] || { echo "$d needs a wrapper at $vdir"; fail=1; continue; }
  fi
  step validate "$vdir"
  if ! (cd "$vdir" && terraform init -backend=false -input=false -no-color >/dev/null && terraform validate -no-color); then
    fail=1
  fi
  step tflint "$d"
  if [[ " $LEGACY_MODULES " == *" $(basename "$d") "* && "$d" == modules/* ]]; then
    # Modules from v1.1.0 and earlier: report, don't fail (fixing them would
    # touch modules whose behavior must not change).
    tflint --config "$ROOT/.tflint.hcl" --chdir "$d" --format compact --minimum-failure-severity=error || fail=1
  else
    tflint --config "$ROOT/.tflint.hcl" --chdir "$d" --format compact || fail=1
  fi
done

# .checkov.baseline holds the findings the v1.1.0 modules already had (see
# docs/checkov-accepted.md). Anything not in it fails.
step checkov "whole repository"
checkov --quiet --compact -d . --framework terraform --skip-path tests --baseline .checkov.baseline || fail=1

exit $fail
