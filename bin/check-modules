#!/usr/bin/env bash
# Static checks for every Terraform module and example: fmt, validate, tflint,
# terraform test (mocked providers), the static site template's tests, the bin/ script tests (stubbed commands),
# the agent plugin (bin/check-plugin and its hook's tests), checkov. Makes no AWS call (validate runs with -backend=false; tests plan
# against mocks). Used by CI.
#
#   bin/check-modules                 # everything
#   bin/check-modules modules/kms-key # one or more directories
set -euo pipefail
cd "$(dirname "$0")/.."
ROOT="$PWD"
source lib/retry.sh
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-$HOME/.terraform.d/plugin-cache}"
mkdir -p "$TF_PLUGIN_CACHE_DIR"

if [[ $# -gt 0 ]]; then
  dirs=("$@")
else
  dirs=()
  dirs+=(".")   # the empty root module the Terraform Registry requires
  for d in modules/*/ examples/*/; do [[ -d "$d" ]] && dirs+=("${d%/}"); done
fi

fail=0
step() { printf '\n== %s: %s\n' "$1" "$2"; }

terraform fmt -check -recursive modules examples tests || { echo "terraform fmt -check failed (run: terraform fmt -recursive modules examples tests)"; fail=1; }

retry tflint --init --config "$ROOT/.tflint.hcl" >/dev/null

for d in "${dirs[@]}"; do
  # A module that needs aliased providers from its caller is validated through
  # its wrapper under tests/validate/.
  vdir="$d"
  if grep -q configuration_aliases "$d"/*.tf 2>/dev/null; then
    vdir="tests/validate/$(basename "$d")"
    [[ -d "$vdir" ]] || { echo "$d needs a wrapper at $vdir"; fail=1; continue; }
  fi
  step validate "$vdir"
  if ! (cd "$vdir" && retry terraform init -backend=false -input=false -no-color >/dev/null && terraform validate -no-color); then
    fail=1
  fi
  step tflint "$d"
  tflint --config "$ROOT/.tflint.hcl" --chdir "$d" --format compact || fail=1
done

# Plan-only tests against mocked providers (modules/<name>/tests/*.tftest.hcl).
for d in "${dirs[@]}"; do
  compgen -G "$d/tests/*.tftest.hcl" >/dev/null || continue
  step test "$d"
  if ! (cd "$d" && retry terraform init -backend=false -input=false -no-color >/dev/null && terraform test -no-color); then
    fail=1
  fi
done

# The bin/ scripts, against stub aws/terraform/docker commands (tests/cli).
if [[ $# -eq 0 ]]; then
  # The static site root bin/new-site renders, in both DNS modes (mocked providers).
  step test "templates/static"
  tests/static-root/run.sh || fail=1
  step test "bin/ scripts"
  tests/cli/run.sh || fail=1
  # The agent plugin: its manifests and skill, and its approval hook (plugins/).
  step check "agent plugin"
  bin/check-plugin || fail=1
  python3 -m unittest discover -s tests/plugin || fail=1
fi

# .checkov.baseline holds the findings the v1.1.0 modules already had (see
# docs/checkov-accepted.md). Anything not in it fails.
step checkov "whole repository"
checkov --quiet --compact -d . --framework terraform --skip-path tests --baseline .checkov.baseline || fail=1

exit $fail
