# Shared Terraform state backend. Copy to backend.tfvars (gitignored) and fill
# in your own bucket and lock table. Each site or app gets its own state KEY
# (devopsfoundry/<domain>/terraform.tfstate), injected by the bin/ scripts, so
# nothing shares state.
#
# Passed to `terraform init -backend-config=...` by the bin/ scripts.
bucket         = "my-terraform-state-123456789012"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "my-terraform-locks"
profile        = "default"
