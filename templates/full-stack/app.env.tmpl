# Build-time config read by `bin/deploy-app` (NOT Terraform). Commit to your repo.

# Path to the Dockerfile, relative to DOCKER_CONTEXT.
DOCKERFILE="Dockerfile"

# Docker build context — relative to this repo's root (the dir containing .devopsfoundry).
DOCKER_CONTEXT="."

# Optional extra `docker build` args, e.g. "--build-arg FOO=bar --no-cache".
DOCKER_BUILD_ARGS=""

# Optional: a script in this repo that asserts the deploy actually WORKS, run
# after the rollout stabilises with the service URL as $1. A non-zero exit fails
# the deploy. Without it, deploy-app only curls health_check_path — which stays
# green over an empty schema, a dead database credential, a frontend whose every
# asset 404s, and an API whose routes do not match what the client calls.
# VERIFY_SCRIPT="scripts/verify-deploy.sh"
