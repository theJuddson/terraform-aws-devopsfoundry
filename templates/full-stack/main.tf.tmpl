# ─────────────────────────────────────────────────────────────
# DevOpsFoundry — full-stack app root for __DOMAIN__
# GENERATED into the consuming repo by `bin/new-app`. This file is a thin
# provider block + a single call into the DevOpsFoundry full-stack module;
# edit app.tfvars for app config, not here.
# ─────────────────────────────────────────────────────────────

terraform {
  required_version = ">= 1.7.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    # Configured in namecheap.tf: from the environment, or with placeholders
    # in an --existing-zone root, which never calls Namecheap.
    namecheap = {
      source  = "namecheap/namecheap"
      version = ">= 2.1.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
  default_tags {
    tags = {
      Project   = "devopsfoundry"
      App       = var.domain_name
      ManagedBy = "terraform"
    }
  }
}

# CloudFront/ACM certs must be in us-east-1.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
  default_tags {
    tags = {
      Project   = "devopsfoundry"
      App       = var.domain_name
      ManagedBy = "terraform"
    }
  }
}

module "app" {
  source = "__MODULE_SOURCE__"
  providers = {
    aws           = aws
    aws.us_east_1 = aws.us_east_1
    namecheap     = namecheap
  }

  name         = var.name
  domain_name  = var.domain_name
  subdomain    = var.subdomain
  service_name = var.service_name
  aws_region   = var.aws_region

  container_image       = var.container_image
  container_port        = var.container_port
  cpu                   = var.cpu
  memory                = var.memory
  desired_count         = var.desired_count
  cpu_architecture      = var.cpu_architecture
  env                   = var.env
  secrets               = var.secrets
  health_check_path     = var.health_check_path
  health_check_matcher  = var.health_check_matcher
  health_check_interval = var.health_check_interval
  health_check_timeout  = var.health_check_timeout

  vpc_cidr = var.vpc_cidr
  az_count = var.az_count

  existing_zone_name          = var.existing_zone_name
  manage_nameservers          = var.manage_nameservers
  enable_nat_gateway          = var.enable_nat_gateway
  tasks_in_public_subnets     = var.tasks_in_public_subnets
  shared_platform             = var.shared_platform
  listener_rule_priority_base = var.listener_rule_priority_base
  platform_name               = var.platform_name # needs the module at v1.6.0 or later

  enable_database = var.enable_database
  enable_cache    = var.enable_cache
  enable_email    = var.enable_email

  db_name                  = var.db_name
  db_instance_class        = var.db_instance_class
  db_allocated_storage     = var.db_allocated_storage
  db_engine_version        = var.db_engine_version
  db_multi_az              = var.db_multi_az
  db_backup_retention_days = var.db_backup_retention_days
  db_deletion_protection   = var.db_deletion_protection
  db_skip_final_snapshot   = var.db_skip_final_snapshot

  cache_node_type      = var.cache_node_type
  cache_engine_version = var.cache_engine_version

  # Opt-in observability and protection (needs the module at v1.3.0 or later)
  enable_flow_logs                       = var.enable_flow_logs
  container_insights                     = var.container_insights
  deployment_circuit_breaker             = var.deployment_circuit_breaker # needs the module at v1.11.0 or later
  alarm_emails                           = var.alarm_emails           # needs the module at v1.13.0 or later
  alarm_sns_topic_arns                   = var.alarm_sns_topic_arns
  alb_deletion_protection                = var.alb_deletion_protection
  db_performance_insights_enabled        = var.db_performance_insights_enabled
  db_monitoring_interval                 = var.db_monitoring_interval
  db_iam_database_authentication_enabled = var.db_iam_database_authentication_enabled
  db_log_min_duration_ms                 = var.db_log_min_duration_ms
  kms_key_arn                            = var.kms_key_arn
  alb_access_logs                        = var.alb_access_logs
  enable_dnssec                          = var.enable_dnssec
  enable_dns_query_logging               = var.enable_dns_query_logging
  cache_num_cache_clusters               = var.cache_num_cache_clusters

  # Opt-in WAF on the ALB (needs the module at v1.3.0 or later; ignored in shared-platform mode)
  create_waf         = var.create_waf
  waf_web_acl_arn    = var.waf_web_acl_arn
  waf_count_only     = var.waf_count_only
  waf_logging        = var.waf_logging # needs the module at v1.16.0 or later
  trust_policy_source_conditions = var.trust_policy_source_conditions # needs the module at v1.17.0 or later
  waf_rate_limit     = var.waf_rate_limit
  waf_rule_overrides = var.waf_rule_overrides

  dmarc_rua_email      = var.dmarc_rua_email
  dmarc_report_zone_id = var.dmarc_report_zone_id

  # Secret rotation state, written by bin/rotate-secret (needs the module at v1.9.0 or later)
  cache_auth_token_generation      = var.cache_auth_token_generation
  cache_auth_token_update_strategy = var.cache_auth_token_update_strategy
  smtp_active_key                  = var.smtp_active_key
  smtp_standby_key                 = var.smtp_standby_key
}
