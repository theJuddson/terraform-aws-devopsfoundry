# Per-site deploy config, read by bin/deploy <domain>.
# Framework-agnostic: point BUILD_DIR at whatever directory holds the built
# static files. Optionally have bin/deploy build it first via BUILD_CMD.

# Directory of built static assets to upload (must contain index.html).
BUILD_DIR="__BUILD_DIR__"

# Optional: command run before upload to produce BUILD_DIR. Leave empty to
# upload BUILD_DIR as-is. Example: "npm ci && npm run build"
BUILD_CMD=""

# Optional: directory in which to run BUILD_CMD (defaults to BUILD_DIR's parent).
SRC_DIR=""
