# Delegates the domain's nameservers at Namecheap to the Route53 zone (Phase 1).
# bin/new-site leaves this file out with --existing-zone: that root has no
# Namecheap provider, so it never needs Namecheap credentials.
# Credentials read from env: NAMECHEAP_API_USER / API_KEY / USER_NAME /
# CLIENT_IP / USE_SANDBOX (see .env).
provider "namecheap" {}

module "namecheap_ns" {
  source      = "__MODULES__/namecheap-ns__MODULE_QUERY__"
  domain_name = var.domain_name
  nameservers = module.route53_zone[0].name_servers
}
