# ─────────────────────────────────────────────────────────────
# DevOpsFoundry — static site root for __DOMAIN__
# GENERATED by bin/new-site. Safe to edit, but re-running new-site
# will not clobber an existing site dir.
#
# Module wiring is ordered so `bin/new-site` can apply in two phases:
#   Phase 1 (-target route53_zone, namecheap_ns): create zone + flip NS.
#   Phase 2 (full apply): validate cert, build CloudFront, add alias records.
# This avoids the cert-validation-vs-NS-propagation race on a fresh domain.
# ─────────────────────────────────────────────────────────────

terraform {
  required_version = ">= 1.7.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    namecheap = {
      source  = "namecheap/namecheap"
      version = ">= 2.1.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
  default_tags {
    tags = {
      Project   = "devopsfoundry"
      Site      = var.domain_name
      ManagedBy = "terraform"
    }
  }
}

# CloudFront ACM certs must live in us-east-1.
provider "aws" {
  alias  = "us_east_1"
  region = "us-east-1"
  default_tags {
    tags = {
      Project   = "devopsfoundry"
      Site      = var.domain_name
      ManagedBy = "terraform"
    }
  }
}

# Credentials read from env: NAMECHEAP_API_USER / API_KEY / USER_NAME /
# CLIENT_IP / USE_SANDBOX (see .env).
provider "namecheap" {}

data "aws_caller_identity" "current" {}

locals {
  # Globally-unique bucket name: <slug>-<account-id>.
  bucket_name = "${var.site_name}-${data.aws_caller_identity.current.account_id}"
}

# 1. ACM cert (us-east-1), initially unvalidated.
module "acm_cert" {
  source      = "__MODULES__/acm-cert__MODULE_QUERY__"
  providers   = { aws = aws.us_east_1 }
  domain_name = var.domain_name
}

# 2. Route53 zone + ACM validation CNAMEs. No CloudFront dependency
#    (Phase 1 targets this).
module "route53_zone" {
  source                        = "__MODULES__/route53-zone__MODULE_QUERY__"
  domain_name                   = var.domain_name
  acm_domain_validation_options = module.acm_cert.domain_validation_options
}

# 3. Delegate the registrar's nameservers to the Route53 zone (Phase 1).
module "namecheap_ns" {
  source      = "__MODULES__/namecheap-ns__MODULE_QUERY__"
  domain_name = var.domain_name
  nameservers = module.route53_zone.name_servers
}

# 4. Wait for issuance once the validation records resolve (Phase 2).
resource "aws_acm_certificate_validation" "main" {
  provider                = aws.us_east_1
  certificate_arn         = module.acm_cert.certificate_arn
  validation_record_fqdns = module.route53_zone.validation_record_fqdns
  timeouts {
    create = "45m"
  }
}

# 5. S3 + CloudFront, using the validated cert (Phase 2).
module "static_site" {
  source          = "__MODULES__/static-site__MODULE_QUERY__"
  site_name       = var.site_name
  domain_name     = var.domain_name
  bucket_name     = local.bucket_name
  certificate_arn = aws_acm_certificate_validation.main.certificate_arn
}

# 6. Point apex + www at CloudFront; optional Google Workspace email (Phase 2).
module "route53_records" {
  source                    = "__MODULES__/route53-records__MODULE_QUERY__"
  domain_name               = var.domain_name
  zone_id                   = module.route53_zone.zone_id
  cloudfront_domain_name    = module.static_site.distribution_domain
  cloudfront_hosted_zone_id = module.static_site.distribution_hosted_zone_id
  enable_google_email       = var.enable_google_email
  google_dkim_key           = var.google_dkim_key
}
