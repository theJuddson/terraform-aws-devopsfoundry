# DevOpsFoundry environment — copy to .env and fill in.
# .env is gitignored; these values are read by the Namecheap Terraform
# provider and the bin/ scripts. NEVER commit real values.

# ── AWS ────────────────────────────────────────────────
# Profile used by aws-cli and the AWS Terraform provider.
# Must resolve to the account that owns the state bucket in backend.tfvars.
export AWS_PROFILE=default
export AWS_REGION=us-east-1
# Optional: bin/preflight warns when the profile resolves to another account.
export DF_EXPECTED_AWS_ACCOUNT=

# ── Namecheap API ──────────────────────────────────────
# Enable API access:  Namecheap → Profile → Tools → Business & Dev Tools →
#   Namecheap API Access → toggle ON. Requires the account to have
#   >=20 domains OR >=$50 balance OR >=$50 spent in the last 2 years.
# Then whitelist the STATIC IPv4 of THIS machine (Manage → Whitelisted IPs).
# The whitelisted IP must equal NAMECHEAP_CLIENT_IP below.
export NAMECHEAP_USER_NAME=your_namecheap_username
export NAMECHEAP_API_USER=your_namecheap_username   # usually same as USER_NAME
export NAMECHEAP_API_KEY=your_namecheap_api_key

# Your machine's whitelisted public IPv4. Leave blank to let bin/* auto-detect
# (curl ifconfig.me) — but it MUST match a whitelisted IP or the API rejects calls.
export NAMECHEAP_CLIENT_IP=

# Use the free sandbox (no eligibility gate) for dry runs. Set to "true" to test
# the Namecheap path without touching production DNS. Sandbox creds are separate
# (sign up at sandbox.namecheap.com) and sandbox domains differ from production.
export NAMECHEAP_USE_SANDBOX=false
